local function PlayUISound(filename)
    if isfile(filename) then
        task.spawn(function()
            local s = Instance.new("Sound")
            s.SoundId = getcustomasset(filename)
            s.Volume = 1
            s.Parent = CoreGui
            s:Play()
            s.Ended:Wait()
            s:Destroy()
        end)
    end
end

